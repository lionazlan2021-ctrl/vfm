# ============================================================
# VFM.com — Environment Variables
# Copy this file to ".env" and fill in real values.
# Lines marked [REQUIRED] must be set or the app will not run.
# Lines marked [OPTIONAL] can stay as-is for local development.
# ============================================================

# [REQUIRED] Database connection string.
# For local development, this SQLite file works with zero setup:
DATABASE_URL="file:./dev.db"
# For production, replace with a real Postgres URL, e.g. from Supabase or Neon:
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# [REQUIRED] Anthropic API key — powers the AI search and chat.
# Get one at https://console.anthropic.com/settings/keys
# Without this, every AI search and chat call will fail with a clear error.
ANTHROPIC_API_KEY="sk-ant-REPLACE-WITH-YOUR-REAL-KEY"

# [REQUIRED] Secret used to sign authentication session tokens (JWT).
# Generate one with: openssl rand -base64 32
AUTH_SECRET="REPLACE-WITH-A-RANDOM-32-BYTE-STRING"

# [OPTIONAL] Public site URL — used for absolute links. Update for production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
