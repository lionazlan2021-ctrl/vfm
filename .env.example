# ============================================================
# VFM.com — Environment Variables
# Copy this file to ".env" and fill in real values.
# Lines marked [REQUIRED] must be set or the app will not run.
# Lines marked [OPTIONAL] can stay as-is for local development.
# ============================================================

# [REQUIRED] Database connection string. Postgres only — this schema has no
# SQLite fallback, so this is needed for local development too, not just
# production. Get a free one from Supabase or Neon — see SETUP.md section 2.6.
DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"

# [REQUIRED] Anthropic API key — powers the AI search and chat.
# Get one at https://console.anthropic.com/settings/keys
# Without this, search and chat return a clear "not configured" error
# (unless VFM_MOCK_SEARCH=1 below).
ANTHROPIC_API_KEY="sk-ant-REPLACE-WITH-YOUR-REAL-KEY"

# [REQUIRED] Secret used to sign authentication session tokens (JWT).
# Generate one with: openssl rand -base64 32
# Changing this signs everyone out, because existing cookies stop verifying.
AUTH_SECRET="REPLACE-WITH-A-RANDOM-32-BYTE-STRING"

# [OPTIONAL] Set to 1 to serve fixed sample search results instead of calling
# Anthropic. Use it to work on the UI without spending money — every flow
# (results, save, track, history, chat) works, the data is just canned.
# Leave unset or 0 in production.
VFM_MOCK_SEARCH=0

# [OPTIONAL] Override the Claude model used for search and chat.
# Defaults to claude-sonnet-5. Only change this if you know the model
# supports the web_search tool — see "Changing the AI model" in README.md.
# VFM_MODEL="claude-sonnet-5"

# [OPTIONAL] Public site URL — used for absolute links. Update for production.
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
