// VFM.com — Database Schema
//
// Provider is Postgres (production). Local dev also points at Postgres now —
// see "Going back to local development after switching to Postgres" in
// SETUP.md if you want SQLite back for offline local work.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // Runtime connections go through Supabase's TRANSACTION pooler (port 6543)
  // with `?pgbouncer=true&connection_limit=1`. Serverless functions each open
  // their own pool and are recycled constantly, so pointing them at the session
  // pooler exhausts its connection slots — which showed up as routes running
  // several queries in parallel failing with a 500 while lighter routes on the
  // same deployment succeeded.
  url = env("DATABASE_URL")

  // Migrations need a real session, which the transaction pooler can't give
  // them (no prepared statements, no advisory locks). This points at the
  // SESSION pooler on 5432 and is used only by `prisma migrate` / `db push`.
  directUrl = env("DIRECT_URL")
}

model User {
  id    String @id @default(cuid())
  // Stored lower-cased by the signup route so addresses are case-insensitive.
  email String @unique

  /// Null for accounts created through Google — they have no password to
  /// verify. The login route must treat null as "this account can't use
  /// password login" rather than comparing against it.
  passwordHash String?

  name      String
  createdAt DateTime @default(now())

  /// Google's stable subject id ("sub"), set when an account signs in with
  /// Google. Unique so one Google account maps to exactly one user. Null for
  /// password-only accounts.
  googleId String? @unique

  /// Profile picture URL from Google, if provided. Display only.
  image String?

  /// Subscription tier: "free" | "pro" | "premium". See lib/plans.ts.
  /// Billing is not wired up — this is set manually (or by a future Stripe
  /// webhook). Anything unrecognised is treated as "free".
  plan String @default("free")

  /// "user" | "admin". Admins can reach /admin. Anything unrecognised is
  /// treated as a normal user, so a typo can never grant access.
  role String @default("user")

  searches Search[]
  saved    SavedProduct[]
  tracked  TrackedProduct[]
  aiCalls  AiCall[]
}

/// One paid AI request — a product search or a follow-up chat — whether it
/// succeeded or not, and whether the caller was signed in or not.
///
/// `Search` only holds signed-in users' successful results (it backs their
/// history), so it can't explain the Anthropic bill: visitors' searches and
/// failed attempts are paid for too and appear nowhere else. This table is the
/// admin panel's source for spend and failures.
model AiCall {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  /// "search" | "chat"
  kind String

  /// Null for visitors who aren't signed in, and kept (as null) if the account
  /// is later deleted, so past spend still adds up.
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  /// The plan the request ran on: "anonymous" | "free" | "pro" | "premium".
  plan  String
  model String

  /// What was searched or asked, trimmed. Shown to admins only.
  query String?

  inputTokens      Int @default(0)
  outputTokens     Int @default(0)
  cacheReadTokens  Int @default(0)
  cacheWriteTokens Int @default(0)
  webSearches      Int @default(0)
  /// Round trips to Anthropic: retries and paused web-search loops add more.
  apiCalls         Int @default(0)

  /// Estimated from published prices (lib/pricing.ts). Anthropic's own console
  /// is the source of truth for what was actually billed.
  costUsd Float @default(0)

  ok          Boolean
  /// The user-facing error code, for failures.
  errorCode   String?
  /// The underlying cause, for admins ("credit balance is too low"). Never sent
  /// to the person who searched.
  errorDetail String?
  durationMs  Int     @default(0)

  @@index([createdAt])
  @@index([userId, createdAt])
}

model Search {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  query String
  /// The full AI response, stored as JSON text. Read back by
  /// GET /api/history/[id] so opening a past search costs nothing.
  resultJson String
  createdAt  DateTime @default(now())

  // Matches the "my searches, newest first" query the history list runs.
  @@index([userId, createdAt])
}

model SavedProduct {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  query       String
  store       String
  price       String
  listingJson String
  createdAt   DateTime @default(now())

  @@unique([userId, query, store])
  @@index([userId, createdAt])
}

model TrackedProduct {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  query       String
  store       String
  price       String
  listingJson String
  createdAt   DateTime @default(now())

  @@unique([userId, query, store])
  @@index([userId, createdAt])
}
