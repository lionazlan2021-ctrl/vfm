// VFM.com — Database Schema
//
// Provider is Postgres (production). Local dev also points at Postgres now —
// see "Going back to local development after switching to Postgres" in
// SETUP.md if you want SQLite back for offline local work.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"

  // Runtime connections go through Supabase's TRANSACTION pooler (port 6543)
  // with `?pgbouncer=true&connection_limit=1`. Serverless functions each open
  // their own pool and are recycled constantly, so pointing them at the session
  // pooler exhausts its connection slots — which showed up as routes running
  // several queries in parallel failing with a 500 while lighter routes on the
  // same deployment succeeded.
  url = env("DATABASE_URL")

  // Migrations need a real session, which the transaction pooler can't give
  // them (no prepared statements, no advisory locks). This points at the
  // SESSION pooler on 5432 and is used only by `prisma migrate` / `db push`.
  directUrl = env("DIRECT_URL")
}

model User {
  id    String @id @default(cuid())
  // Stored lower-cased by the signup route so addresses are case-insensitive.
  email String @unique

  /// Null for accounts created through Google — they have no password to
  /// verify. The login route must treat null as "this account can't use
  /// password login" rather than comparing against it.
  passwordHash String?

  name      String
  createdAt DateTime @default(now())

  /// Google's stable subject id ("sub"), set when an account signs in with
  /// Google. Unique so one Google account maps to exactly one user. Null for
  /// password-only accounts.
  googleId String? @unique

  /// Profile picture URL from Google, if provided. Display only.
  image String?

  /// Subscription tier: "free" | "pro" | "premium". See lib/plans.ts.
  /// Billing is not wired up — this is set manually (or by a future Stripe
  /// webhook). Anything unrecognised is treated as "free".
  plan String @default("free")

  /// "user" | "admin". Admins can reach /admin. Anything unrecognised is
  /// treated as a normal user, so a typo can never grant access.
  role String @default("user")

  searches Search[]
  saved    SavedProduct[]
  tracked  TrackedProduct[]
}

model Search {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  query String
  /// The full AI response, stored as JSON text. Read back by
  /// GET /api/history/[id] so opening a past search costs nothing.
  resultJson String
  createdAt  DateTime @default(now())

  // Matches the "my searches, newest first" query the history list runs.
  @@index([userId, createdAt])
}

model SavedProduct {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  query       String
  store       String
  price       String
  listingJson String
  createdAt   DateTime @default(now())

  @@unique([userId, query, store])
  @@index([userId, createdAt])
}

model TrackedProduct {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  query       String
  store       String
  price       String
  listingJson String
  createdAt   DateTime @default(now())

  @@unique([userId, query, store])
  @@index([userId, createdAt])
}
