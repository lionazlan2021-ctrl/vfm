// VFM.com — Database Schema
//
// Provider is Postgres (production). Local dev also points at Postgres now —
// see "Going back to local development after switching to Postgres" in
// SETUP.md if you want SQLite back for offline local work.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  // Stored lower-cased by the signup route so addresses are case-insensitive.
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())

  /// Subscription tier: "free" | "pro" | "premium". See lib/plans.ts.
  /// Billing is not wired up — this is set manually (or by a future Stripe
  /// webhook). Anything unrecognised is treated as "free".
  plan String @default("free")

  searches Search[]
  saved    SavedProduct[]
  tracked  TrackedProduct[]
}

model Search {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  query String
  /// The full AI response, stored as JSON text. Read back by
  /// GET /api/history/[id] so opening a past search costs nothing.
  resultJson String
  createdAt  DateTime @default(now())

  // Matches the "my searches, newest first" query the history list runs.
  @@index([userId, createdAt])
}

model SavedProduct {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  query       String
  store       String
  price       String
  listingJson String
  createdAt   DateTime @default(now())

  @@unique([userId, query, store])
  @@index([userId, createdAt])
}

model TrackedProduct {
  id String @id @default(cuid())

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  query       String
  store       String
  price       String
  listingJson String
  createdAt   DateTime @default(now())

  @@unique([userId, query, store])
  @@index([userId, createdAt])
}
